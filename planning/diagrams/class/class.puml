@startuml
skinparam classAttributeIconSize 0
left to right direction

package "Auth / Tenant Service" {
  class Tenant {
    +UUID id
    +String name
    +String slug
    +String plan
    +DateTime createdAt
    +configureAccount()
    +updateSettings()
  }

  class TenantSettings {
    +UUID id
    +String defaultPostVisibility
    +Boolean allowPublicDiscovery
    +Boolean allowComments
    +DateTime updatedAt
  }

  class User {
    +UUID id
    +String username
    +String email
    +String passwordHash
    +UserRole role
    +DateTime createdAt
    +register()
    +login()
    +updateProfile()
    +followUser()
  }

  class UserProfile {
    +UUID id
    +String displayName
    +String bio
    +String profileImageUrl
    +String fitnessGoal
    +viewProfile()
    +viewUserFeed()
  }
}

package "Social Feed Service" {
  class Post {
    +UUID id
    +PostType postType
    +String caption
    +String mediaUrl
    +PostVisibility visibility
    +DateTime createdAt
    +createPost()
    +editPost()
    +deletePost()
  }

  class Comment {
    +UUID id
    +String body
    +DateTime createdAt
    +editComment()
    +deleteComment()
  }

  class Like {
    +UUID id
    +DateTime createdAt
  }

  class Follow {
    +UUID id
    +DateTime createdAt
  }

  class UserFeed {
    +UUID id
    +getPosts()
    +filterPosts()
  }
}

package "Workout Logging Service" {
  class Workout {
    +UUID id
    +String title
    +String workoutType
    +Integer durationMinutes
    +String notes
    +DateTime createdAt
    +addExercise()
    +removeExercise()
  }

  class Exercise {
    +UUID id
    +String name
    +String muscleGroup
    +String notes
  }

  class WorkoutSet {
    +UUID id
    +Integer setNumber
    +Integer reps
    +Decimal weight
    +Integer restSeconds
  }
}

package "Nutrition Logging Service" {
  class FoodLog {
    +UUID id
    +String mealType
    +String title
    +Integer calories
    +Decimal protein
    +Decimal carbs
    +Decimal fat
    +String notes
    +DateTime createdAt
    +addFoodItem()
  }

  class FoodItem {
    +UUID id
    +String name
    +Integer calories
    +Decimal protein
    +Decimal carbs
    +Decimal fat
    +Decimal quantity
    +String unit
  }
}

enum UserRole {
  TENANT_ADMIN
  USER
}

enum PostType {
  WORKOUT
  FOOD
  GENERAL
  PROGRESS
}

enum PostVisibility {
  PUBLIC
  TENANT_ONLY
  FOLLOWERS_ONLY
  PRIVATE
}

Tenant "1" o-- "1" TenantSettings
Tenant "1" o-- "many" User

User "1" o-- "1" UserProfile
User "1" --> "many" Post : creates
User "1" --> "many" Workout : logs
User "1" --> "many" FoodLog : logs
User "1" --> "many" Comment : writes
User "1" --> "many" Like : gives

User "1" --> "1" UserFeed : owns

Post "1" --> "0..1" Workout : contains
Post "1" --> "0..1" FoodLog : contains
Post "1" o-- "many" Comment
Post "1" o-- "many" Like

Workout "1" o-- "many" Exercise
Exercise "1" o-- "many" WorkoutSet

FoodLog "1" o-- "many" FoodItem

Follow "many" --> "1" User : follower
Follow "many" --> "1" User : following

User --> UserRole
Post --> PostType
Post --> PostVisibility

@enduml
