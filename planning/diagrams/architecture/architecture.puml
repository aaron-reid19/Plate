actor "User" as user

cloud "Public Edge" as edge {
  component "Browser / Installed Plate PWA" as pwa <<Edge>>
  component "Cloudflare DNS + TLS\nproxy / tunnel" as cloudflare <<Edge>>
}

node "Kubernetes Cluster\nK3s current single-node; expandable to workers" as cluster {
  component "Kubernetes Ingress\npublic entry point" as ingress <<Edge>>
  component "Nginx Ingress Controller\nhandles Ingress resources" as nginx <<Edge>>

  package "Namespace: plate-app" as app {
    component "nextjs-svc\nClusterIP Service" as nextSvc <<Edge>>
    component "Next.js Frontend\nDeployment Pods" as nextPods <<Edge>>

    component "identity-svc\nClusterIP Service" as identitySvc <<Auth>>
    component "Identity and Tenant API\nDeployment Pods" as identityPods <<Auth>>

    component "workout-svc\nClusterIP Service" as workoutSvc <<Workout>>
    component "Workout API\nDeployment Pods" as workoutPods <<Workout>>

    component "nutrition-svc\nClusterIP Service" as nutritionSvc <<Nutrition>>
    component "Nutrition API\nDeployment Pods" as nutritionPods <<Nutrition>>

    component "social-svc\nClusterIP Service" as socialSvc <<Social>>
    component "Social API + consumer\nDeployment Pods" as socialPods <<Social>>

    component "analytics-svc\nClusterIP Service" as analyticsSvc <<Passive>>
    component "Analytics API + consumer\nDeployment Pods" as analyticsPods <<Passive>>

    component "notification-svc\nClusterIP Service" as notificationSvc <<Passive>>
    component "Notification consumer\nDeployment Pods" as notificationPods <<Passive>>

    artifact "ConfigMaps\nservice URLs, topics, flags, logging" as configMaps
    artifact "Secrets\ncredentials and API keys\n(values not shown)" as secrets
  }

  package "Namespace: plate-data" as data {
    component "auth-db-svc\nClusterIP Service" as authDbSvc
    database "Auth PostgreSQL\nStatefulSet\nservice-owned schema" as authDb <<Auth>>

    component "workout-db-svc\nClusterIP Service" as workoutDbSvc
    database "Workout PostgreSQL\nStatefulSet\nservice-owned schema" as workoutDb <<Workout>>

    component "nutrition-db-svc\nClusterIP Service" as nutritionDbSvc
    database "Nutrition PostgreSQL\nStatefulSet\nservice-owned schema" as nutritionDb <<Nutrition>>

    component "social-db-svc\nClusterIP Service" as socialDbSvc
    database "Social PostgreSQL\nStatefulSet\nservice-owned schema" as socialDb <<Social>>

    artifact "outbox_events tables\none per service database" as outboxTables
    storage "Persistent storage\nStorageClass -> PV -> PVC\nDB and Kafka data survives Pod restart" as persistentStorage
    component "Backup CronJob\nseparate backup storage" as backup
  }

  package "Namespace: plate-events" as events {
    queue "Kafka\nStatefulSet + ClusterIP Service" as kafka
    artifact "Kafka topics\ndomain events" as domainTopics
    queue "Retry topics" as retryTopics
    queue "Dead-letter topics" as deadLetterTopics

    component "Kafka Connect\nDeployment + ClusterIP Service" as kafkaConnect
    component "Debezium outbox connector" as debezium
  }
}

user --> pwa : uses app
pwa --> cloudflare : external HTTPS
cloudflare -[#1F6FEB]-> ingress : HTTPS 443
ingress -[#1F6FEB]-> nginx : Ingress handling

nginx -[#2F855A]-> nextSvc : HTTPS / frontend
nginx -[#2F855A]-> identitySvc : HTTP /api/identity/*
nginx -[#2F855A]-> workoutSvc : HTTP /api/workouts/*
nginx -[#2F855A]-> nutritionSvc : HTTP /api/nutrition/*
nginx -[#2F855A]-> socialSvc : HTTP /api/social/*
nginx -[#2F855A]-> analyticsSvc : HTTP /api/analytics/*

nextSvc -[#2F855A]-> nextPods : selects Pods
identitySvc -[#2F855A]-> identityPods : selects Pods
workoutSvc -[#2F855A]-> workoutPods : selects Pods
nutritionSvc -[#2F855A]-> nutritionPods : selects Pods
socialSvc -[#2F855A]-> socialPods : selects Pods
analyticsSvc -[#2F855A]-> analyticsPods : selects Pods
notificationSvc -[#2F855A]-> notificationPods : selects Pods

identityPods -[#7B61A8]-> authDbSvc : PostgreSQL via K8s DNS
workoutPods -[#7B61A8]-> workoutDbSvc : PostgreSQL via K8s DNS
nutritionPods -[#7B61A8]-> nutritionDbSvc : PostgreSQL via K8s DNS
socialPods -[#7B61A8]-> socialDbSvc : PostgreSQL via K8s DNS
authDbSvc -[#7B61A8]-> authDb : routes to DB
workoutDbSvc -[#7B61A8]-> workoutDb : routes to DB
nutritionDbSvc -[#7B61A8]-> nutritionDb : routes to DB
socialDbSvc -[#7B61A8]-> socialDb : routes to DB

identityPods -[#7B61A8]-> outboxTables : one transaction: business data + outbox
workoutPods -[#7B61A8]-> outboxTables : one transaction: business data + outbox
nutritionPods -[#7B61A8]-> outboxTables : one transaction: business data + outbox
socialPods -[#7B61A8]-> outboxTables : one transaction: business data + outbox
authDb --> outboxTables : contains auth outbox
workoutDb --> outboxTables : contains workout outbox
nutritionDb --> outboxTables : contains nutrition outbox
socialDb --> outboxTables : contains social outbox

outboxTables -[#B7791F]-> debezium : CDC reads outbox rows
debezium -[#B7791F]-> kafkaConnect : connector runs through Connect
kafkaConnect -[#B7791F]-> kafka : publishes event records
kafka --> domainTopics : routes domain events

kafka -[#B7791F]-> socialPods : async event consumption
kafka -[#B7791F]-> analyticsPods : async event consumption
kafka -[#B7791F]-> notificationPods : async event consumption
analyticsPods -[#B7791F]-> retryTopics : transient failure
retryTopics -[#B7791F]-> analyticsPods : retry delivery
notificationPods -[#B7791F]-> deadLetterTopics : exhausted failure

configMaps ..> nextPods : config injection
configMaps ..> identityPods : config injection
configMaps ..> workoutPods : config injection
configMaps ..> nutritionPods : config injection
configMaps ..> socialPods : config injection
configMaps ..> analyticsPods : config injection
configMaps ..> notificationPods : config injection
secrets ..> identityPods : secret injection
secrets ..> workoutPods : secret injection
secrets ..> nutritionPods : secret injection
secrets ..> socialPods : secret injection
secrets ..> kafkaConnect : secret injection

authDb --> persistentStorage : PVC mount
workoutDb --> persistentStorage : PVC mount
nutritionDb --> persistentStorage : PVC mount
socialDb --> persistentStorage : PVC mount
kafka --> persistentStorage : broker PVC mount
backup --> persistentStorage : backup PVC

note right of nginx
External traffic path:
User Device -> Cloudflare ->
Kubernetes Ingress -> Nginx Ingress Controller
-> ClusterIP Service -> Application Pod.

Only the Ingress is publicly reachable.
All ClusterIP Services and internal ports stay private.
ClusterIP Services provide Kubernetes DNS/service discovery.
end note

note bottom of outboxTables
The outbox is the publication boundary.
Domain services do not publish directly to Kafka
and do not call one another directly. Consumers
process events idempotently; failed records retry
and can be moved to dead-letter topics.
end note

note bottom of data
Each service owns its PostgreSQL schema/database.
There are no cross-service database foreign keys.
Persistent Kubernetes storage is distinct from
ephemeral container storage and external backups.
end note

note bottom of cluster
The current home-server topology is one K3s node, so a single replica or
single PostgreSQL/Kafka instance is not high availability. Stateless
Deployments can scale horizontally when worker nodes are added later.
end note

legend right
  |= Visual cue |= Meaning |
  |<#1F6FEB> blue arrow | external HTTPS / ingress traffic |
  |<#2F855A> green arrow | synchronous HTTP / service routing |
  |<#7B61A8> purple arrow | database communication |
  |<#B7791F> amber arrow | asynchronous Kafka event flow |
  | ..> dotted arrow | ConfigMap or Secret injection |
endlegend

@enduml
